# GEMINI_API_KEY: Required for Gemini AI API calls on Vercel Serverless & local server.
# Configure this in your Vercel Project Settings > Environment Variables.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted (e.g. https://neyrunway.vercel.app)
APP_URL=

# Optional Client-side Firebase overrides (if not using bundled firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
